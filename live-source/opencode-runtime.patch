+import { afterEach, describe, expect, test } from "bun:test"
+import { DaemonControl } from "@/server/daemon-control"
+
+describe("daemon control", () => {
+  afterEach(() => DaemonControl.reset())
+
+  test("does not expose identity or stop without the token", async () => {
+    let stopped = false
+    void DaemonControl.configure({ id: "daemon-test", token: "secret" }).then(() => {
+      stopped = true
+    })
+
+    expect(DaemonControl.info("wrong")).toBeUndefined()
+    expect(DaemonControl.stop("wrong")).toBe(false)
+    await Promise.resolve()
+    expect(stopped).toBe(false)
+  })
+
+  test("returns identity and signals shutdown with the token", async () => {
+    const stopped = DaemonControl.configure({ id: "daemon-test", token: "secret" })
+
+    expect(DaemonControl.info("secret")).toEqual({ id: "daemon-test", pid: process.pid })
+    expect(DaemonControl.stop("secret")).toBe(true)
+    expect(await stopped).toBeUndefined()
+  })
+})
