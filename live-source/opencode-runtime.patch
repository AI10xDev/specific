+afterEach(async () => {
+  for (const resource of resources.splice(0)) {
+    if (resource.child.exitCode === null) {
+      writeFileSync(path.join(resource.inbox, "STOP"), "", { mode: 0o600 })
+      await until(
+        () => resource.child.exitCode,
+        (code) => code !== null,
+      )
+    }
+    rmSync(resource.directory, { recursive: true, force: true })
+  }
+})
