diff --git a/packages/opencode/src/cli/cmd/daemon.ts b/packages/opencode/src/cli/cmd/daemon.ts
new file mode 100644
index 0000000000..bd848298ba
--- /dev/null
+++ b/packages/opencode/src/cli/cmd/daemon.ts
@@ -0,0 +1,59 @@
+import { Effect } from "effect"
+import { effectCmd, fail } from "../effect-cmd"
+import { withNetworkOptions, type NetworkOptions } from "../network"
+
+type Args = NetworkOptions & {
+  action: "start" | "status" | "stop"
+  output?: string
+  includeReasoning?: boolean
+}
+
+const attempt = <A>(run: () => Promise<A>) =>
+  Effect.tryPromise({
+    try: run,
+    catch: (cause) => (cause instanceof Error ? cause : new Error(String(cause))),
+  })
+
+export const DaemonCommand = effectCmd({
+  command: "daemon <action>",
+  describe: "manage the background opencode server",
+  instance: false,
+  builder: (yargs) =>
+    withNetworkOptions(yargs)
+      .positional("action", { choices: ["start", "status", "stop"] as const, demandOption: true })
+      .option("output", {
+        type: "string",
+        describe: "append observable assistant activity to this text file",
+      })
+      .option("include-reasoning", {
+        type: "boolean",
+        default: false,
+        describe: "include provider-exposed reasoning events (never hidden internal reasoning)",
+      }),
+  handler: Effect.fn("Cli.daemon")(function* (args: Args) {
+    const { Daemon } = yield* Effect.promise(() => import("../daemon"))
+    if (args.action === "status") {
+      const info = yield* Effect.promise(() => Daemon.status())
+      console.log(info ? `running ${info.url}\noutput ${info.output}` : "stopped")
+      return
+    }
+    if (args.action === "stop") {
+      const stopped = yield* attempt(() => Daemon.stop()).pipe(Effect.catch((error) => fail(error.message)))
+      console.log(stopped ? "stopped" : "already stopped")
+      return
+    }
+    const info = yield* attempt(() =>
+      Daemon.start({
+        output: args.output,
+        includeReasoning: args.includeReasoning,
+        port: args.port,
+        hostname: args.hostname,
+        mdns: args.mdns,
+        mdnsDomain: args["mdns-domain"],
+        cors: Array.isArray(args.cors) ? args.cors : args.cors ? [args.cors] : [],
+      }),
+    ).pipe(Effect.catch((error) => fail(error.message)))
+    console.log(`running ${info.url}`)
+    console.log(`output ${info.output}`)
+  }),
+})
