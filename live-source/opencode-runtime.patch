+export async function readPipedStdin(
+  stdin: NodeJS.ReadStream = process.stdin,
+  read: () => Promise<string> = () => Bun.stdin.text(),
+) {
+  if (stdin.isTTY) return
+
+  return read().catch((error) => {
+    // nohup replaces terminal stdin with a write-only /dev/null descriptor.
+    if (error instanceof Error && "code" in error && error.code === "EBADF") return undefined
+    throw error
+  })
+}
