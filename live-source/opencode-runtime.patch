+import { describe, expect } from "bun:test"
+import { Effect } from "effect"
+import path from "node:path"
+import { cliIt } from "../../lib/cli-process"
+
+describe("opencode daemon (subprocess)", () => {
+  cliIt.live(
+    "starts, reports status, writes output, and stops",
+    ({ home, opencode }) => {
+      const output = path.join(home, "daemon-output.txt")
+      return Effect.gen(function* () {
+        const started = yield* opencode.spawn(["daemon", "start", "--port", "0", "--output", output], {
+          timeoutMs: 60_000,
+        })
+        opencode.expectExit(started, 0, "daemon start")
+        expect(started.stdout).toContain("running http://")
+        expect(started.stdout).toContain(`output ${output}`)
+
+        const status = yield* opencode.spawn(["daemon", "status"])
+        opencode.expectExit(status, 0, "daemon status")
+        expect(status.stdout).toContain("running http://")
+
+        const stopped = yield* opencode.spawn(["daemon", "stop"])
+        opencode.expectExit(stopped, 0, "daemon stop")
+        expect(stopped.stdout).toContain("stopped")
+
+        const finalStatus = yield* opencode.spawn(["daemon", "status"])
+        expect(finalStatus.stdout.trim()).toBe("stopped")
+        expect(yield* Effect.promise(() => Bun.file(output).text())).toContain("session=daemon started")
+      }).pipe(Effect.ensuring(opencode.spawn(["daemon", "stop"], { timeoutMs: 10_000 }).pipe(Effect.ignore)))
+    },
+    90_000,
+  )
+})
