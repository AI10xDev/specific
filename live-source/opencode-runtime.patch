+function shutdownSignal() {
+  return Effect.callback<void>((resume) => {
+    const done = () => resume(Effect.void)
+    process.once("SIGINT", done)
+    process.once("SIGTERM", done)
+    process.once("SIGHUP", done)
+    return Effect.sync(() => {
+      process.off("SIGINT", done)
+      process.off("SIGTERM", done)
+      process.off("SIGHUP", done)
+    })
+  })
+}
+
+function controlUrl(server: { hostname: string; port: number }) {
+  const hostname = server.hostname === "0.0.0.0" ? "127.0.0.1" : server.hostname === "::" ? "::1" : server.hostname
+  const url = new URL("http://localhost")
+  url.hostname = hostname
+  url.port = String(server.port)
+  return url.toString()
+}
 
