new file mode 100644
index 0000000000..92e5f12b70
--- /dev/null
+++ b/packages/opencode/src/cli/daemon-output.ts
@@ -0,0 +1,126 @@
+import { GlobalBus, type GlobalEvent } from "@/bus/global"
+import { createWriteStream } from "node:fs"
+import path from "node:path"
+import fs from "node:fs/promises"
+
+type Dict = Record<string, unknown>
+
+function record(value: unknown): Dict | undefined {
+  if (!value || typeof value !== "object" || Array.isArray(value)) return undefined
+  // GlobalBus is a legacy compatibility boundary whose payload is intentionally untyped.
+  // oxlint-disable-next-line typescript-eslint/no-unsafe-type-assertion
+  return value as Dict
+}
+
+function text(value: unknown) {
+  return typeof value === "string" ? value : undefined
+}
+
+function errorKind(value: unknown) {
+  const error = record(value)
+  return text(error?.name) ?? "unknown error"
+}
+
+export async function createDaemonOutput(file: string, includeReasoning: boolean) {
+  await fs.mkdir(path.dirname(file), { recursive: true, mode: 0o700 })
+  const output = createWriteStream(file, { flags: "a", mode: 0o600 })
+  await new Promise<void>((resolve, reject) => {
+    output.once("open", () => resolve())
+    output.once("error", reject)
+  })
+  await fs.chmod(file, 0o600)
+  const roles = new Map<string, string>()
+  const parts = new Map<string, string>()
+  const failed = new Promise<never>((_, reject) => output.once("error", reject))
+
+  const write = (sessionID: string, kind: string, value: string) => {
+    output.write(`${new Date().toISOString()} session=${sessionID} ${kind} ${JSON.stringify(value)}\n`)
+  }
+
+  const handler = (event: GlobalEvent) => {
+    const payload = record(event.payload)
+    const type = text(payload?.type)
+    const data = record(payload?.properties)
+    if (!type || !data) return
+    const sessionID = text(data.sessionID) ?? "unknown"
+
+    if (type === "session.next.text.delta") {
+      const delta = text(data.delta)
+      if (delta) write(sessionID, "assistant", delta)
+      return
+    }
+    if (type === "session.next.reasoning.delta") {
+      const delta = text(data.delta)
+      if (includeReasoning && delta) write(sessionID, "reasoning", delta)
+      return
+    }
+    if (type === "session.next.tool.called") {
+      write(sessionID, "tool.started", text(data.tool) ?? "unknown")
+      return
+    }
+    if (type === "session.next.tool.success") {
+      write(sessionID, "tool.completed", text(data.callID) ?? "unknown")
+      return
+    }
+    if (type === "session.next.tool.failed") {
+      write(sessionID, "tool.failed", text(data.callID) ?? "unknown")
+      return
+    }
+    if (type === "session.next.step.failed") {
+      write(sessionID, "error", errorKind(data.error))
+      return
+    }
+    if (type === "session.next.retried") {
+      write(sessionID, "retry", typeof data.attempt === "number" ? String(data.attempt) : "unknown")
+      return
+    }
+    if (type === "message.updated") {
+      const info = record(data.info)
+      const id = text(info?.id)
+      const role = text(info?.role)
+      if (id && role) roles.set(id, role)
+      if (role === "assistant" && info?.error) write(sessionID, "error", errorKind(info.error))
+      return
+    }
+    if (type === "message.part.updated") {
+      const part = record(data.part)
+      const id = text(part?.id)
+      const kind = text(part?.type)
+      if (id && kind) parts.set(id, kind)
+      return
+    }
+    if (type !== "message.part.delta" || data.field !== "text") return
+    const messageID = text(data.messageID)
+    const partID = text(data.partID)
+    const delta = text(data.delta)
+    if (!messageID || !partID || !delta || roles.get(messageID) !== "assistant") return
+    const kind = parts.get(partID)
+    if (kind === "text") write(sessionID, "assistant", delta)
+    if (includeReasoning && kind === "reasoning") write(sessionID, "reasoning", delta)
+  }
+
+  GlobalBus.on("event", handler)
+  write("daemon", "started", `pid=${process.pid}`)
+
+  return {
+    failed,
+    close: async () => {
+      GlobalBus.off("event", handler)
+      if (output.closed || output.destroyed) return
+      await new Promise<void>((resolve) => {
+        const done = () => {
+          output.off("finish", done)
+          output.off("close", done)
+          output.off("error", done)
+          resolve()
+        }
+        output.once("finish", done)
+        output.once("close", done)
+        output.once("error", done)
+        output.end()
+      })
+    },
+  }
+}
+
+export * as DaemonOutput from "./daemon-output"
diff --git a/packages/opencode/src/cli/daemon.ts b/packages/opencode/src/cli/daemon.ts
new file mode 100644
index 0000000000..fbad4a7387
--- /dev/null
+++ b/packages/opencode/src/cli/daemon.ts
@@ -0,0 +1,216 @@
+import { Global } from "@opencode-ai/core/global"
+import { Flock } from "@opencode-ai/core/util/flock"
+import { InstallationVersion } from "@opencode-ai/core/installation/version"
+import { randomUUID } from "node:crypto"
+import { spawn } from "node:child_process"
+import fs from "node:fs/promises"
+import path from "node:path"
+import { Option, Schema } from "effect"
+
+const directory = path.join(Global.Path.state, "daemon")
+const registrationFile = path.join(directory, "registration.json")
+const lifecycleLog = path.join(Global.Path.log, "daemon.log")
+const controlPath = "/_opencode/daemon"
+
+const Registration = Schema.Struct({
+  id: Schema.String,
+  token: Schema.String,
+  version: Schema.String,
+  url: Schema.String,
+  pid: Schema.Int.check(Schema.isGreaterThan(0)),
+  output: Schema.String,
+})
+export type Registration = typeof Registration.Type
+
+type StartOptions = {
+  output?: string
+  includeReasoning?: boolean
+  port?: number
+  hostname?: string
+  mdns?: boolean
+  mdnsDomain?: string
+  cors?: string[]
+}
+
+const Launch = Schema.Struct({
+  id: Schema.String,
+  token: Schema.String,
+  output: Schema.String,
+  includeReasoning: Schema.Boolean,
+})
+export type Launch = typeof Launch.Type
+
+function parseRegistration(value: unknown): Registration | undefined {
+  return Option.getOrUndefined(Schema.decodeUnknownOption(Registration)(value))
+}
+
+async function readRegistration() {
+  return fs
+    .readFile(registrationFile, "utf8")
+    .then((value) => parseRegistration(JSON.parse(value)))
+    .catch(() => undefined)
+}
+
+async function probe(info: Registration) {
+  return fetch(new URL(controlPath, info.url), {
+    headers: { "x-opencode-daemon-token": info.token },
+    signal: AbortSignal.timeout(2_000),
+  })
+    .then(async (response) => {
+      if (!response.ok) return false
+      const data: unknown = await response.json()
+      if (!data || typeof data !== "object") return false
+      const id = Reflect.get(data, "id") as unknown
+      const pid = Reflect.get(data, "pid") as unknown
+      return id === info.id && pid === info.pid
+    })
+    .catch(() => false)
+}
+
+async function running(pid: number) {
+  try {
+    process.kill(pid, 0)
+    return true
+  } catch {
+    return false
+  }
+}
+
+async function remove(info: Registration) {
+  const current = await readRegistration()
+  if (current?.id !== info.id || current.token !== info.token) return
+  await fs.rm(registrationFile, { force: true })
+}
+
+export async function register(info: Registration) {
+  await fs.mkdir(directory, { recursive: true, mode: 0o700 })
+  await fs.chmod(directory, 0o700).catch(() => undefined)
+  const temp = path.join(directory, `${info.id}.tmp`)
+  await fs.writeFile(temp, JSON.stringify(info), { flag: "wx", mode: 0o600 })
+  await fs.rename(temp, registrationFile)
+}
+
+export async function consumeLaunch(file: string) {
+  const resolved = path.resolve(file)
+  if (path.dirname(resolved) !== directory || !path.basename(resolved).endsWith(".launch"))
+    throw new Error("Invalid daemon launch file")
+  const value = await fs.readFile(resolved, "utf8").finally(() => fs.rm(resolved, { force: true }))
+  const input = Option.getOrUndefined(Schema.decodeUnknownOption(Launch)(JSON.parse(value) as unknown))
+  if (!input) throw new Error("Invalid daemon launch data")
+  return input
+}
+
+export async function unregister(info: Registration) {
+  await remove(info)
+}
+
+export async function status() {
+  const info = await readRegistration()
+  if (!info || info.version !== InstallationVersion) return undefined
+  if (!(await probe(info))) return undefined
+  return info
+}
+
+function childCommand(args: string[]) {
+  const compiled = path.basename(process.execPath).replace(/\.exe$/, "") !== "bun"
+  if (compiled) return { command: process.execPath, args }
+  if (!process.argv[1]) throw new Error("Failed to resolve CLI entrypoint")
+  return { command: process.execPath, args: ["run", "--conditions=browser", path.resolve(process.argv[1]), ...args] }
+}
+
+async function waitForStart(id: string, child: ReturnType<typeof spawn>) {
+  for (let attempt = 0; attempt < 100; attempt++) {
+    const info = await readRegistration()
+    if (info?.id === id && (await probe(info))) return info
+    if (child.exitCode !== null || child.signalCode !== null)
+      throw new Error(`Daemon exited during startup; see ${lifecycleLog}`)
+    await Bun.sleep(50)
+  }
+  throw new Error(`Timed out starting daemon; see ${lifecycleLog}`)
+}
+
+export async function start(options: StartOptions = {}) {
+  return Flock.withLock("opencode-daemon", async () => {
+    const existing = await readRegistration()
+    if (existing && (await probe(existing))) {
+      if (existing.version !== InstallationVersion) throw new Error("A daemon from another version is already running")
+      return existing
+    }
+    if (existing && (await running(existing.pid))) {
+      throw new Error(`Refusing to replace unverified live daemon process ${existing.pid}`)
+    }
+    if (existing) await remove(existing)
+
+    const id = randomUUID()
+    const token = randomUUID()
+    const output = path.resolve(options.output ?? path.join(Global.Path.log, "daemon-output.txt"))
+    await fs.mkdir(directory, { recursive: true, mode: 0o700 })
+    await fs.chmod(directory, 0o700).catch(() => undefined)
+    const launch = path.join(directory, `${id}.launch`)
+    await fs.writeFile(
+      launch,
+      JSON.stringify({ id, token, output, includeReasoning: options.includeReasoning ?? false } satisfies Launch),
+      { flag: "wx", mode: 0o600 },
+    )
+    const args = ["serve", "--daemon-launch", launch]
+    if (options.port !== undefined) args.push("--port", String(options.port))
+    if (options.hostname) args.push("--hostname", options.hostname)
+    if (options.mdns !== undefined) args.push(options.mdns ? "--mdns" : "--no-mdns")
+    if (options.mdnsDomain) args.push("--mdns-domain", options.mdnsDomain)
+    for (const cors of options.cors ?? []) args.push("--cors", cors)
+
+    await fs.mkdir(path.dirname(lifecycleLog), { recursive: true, mode: 0o700 })
+    await fs.mkdir(Global.Path.home, { recursive: true })
+    const log = await fs.open(lifecycleLog, "a", 0o600)
+    const command = childCommand(args)
+    const child = spawn(command.command, command.args, {
+      cwd: Global.Path.home,
+      detached: true,
+      stdio: ["ignore", log.fd, log.fd],
+      windowsHide: true,
+    })
+    await new Promise<void>((resolve, reject) => {
+      child.once("spawn", resolve)
+      child.once("error", reject)
+    }).finally(() => log.close())
+    child.unref()
+
+    return waitForStart(id, child).catch(async (error) => {
+      child.kill("SIGTERM")
+      await Promise.race([new Promise((resolve) => child.once("exit", resolve)), Bun.sleep(2_000)])
+      if (child.exitCode === null && child.signalCode === null) child.kill("SIGKILL")
+      const info = await readRegistration()
+      if (info?.id === id) await remove(info)
+      await fs.rm(launch, { force: true })
+      throw error
+    })
+  })
+}
+
+export async function stop() {
+  return Flock.withLock("opencode-daemon", async () => {
+    const info = await readRegistration()
+    if (!info) return false
+    if (!(await probe(info))) {
+      if (!(await running(info.pid))) {
+        await remove(info)
+        return false
+      }
+      throw new Error(`Refusing to stop unverified live daemon process ${info.pid}`)
+    }
+    const response = await fetch(new URL(controlPath, info.url), {
+      method: "POST",
+      headers: { "x-opencode-daemon-token": info.token },
+      signal: AbortSignal.timeout(2_000),
+    })
+    if (!response.ok) throw new Error(`Daemon rejected shutdown request (${response.status})`)
+    for (let attempt = 0; attempt < 100; attempt++) {
+      const current = await readRegistration()
+      if (!current || current.id !== info.id) return true
+      await Bun.sleep(50)
+    }
+    throw new Error("Timed out waiting for daemon shutdown")
+  })
+}
+
+export * as Daemon from "./daemon"
