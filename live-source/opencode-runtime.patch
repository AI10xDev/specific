+import { describe, expect, test } from "bun:test"
+import { GlobalBus } from "@/bus/global"
+import { createDaemonOutput } from "@/cli/daemon-output"
+import { tmpdir } from "../fixture/fixture"
+import path from "node:path"
+
+describe("daemon output", () => {
+  test("streams observable text while redacting tool data and reasoning by default", async () => {
+    await using tmp = await tmpdir()
+    const file = path.join(tmp.path, "output.txt")
+    const output = await createDaemonOutput(file, false)
+    try {
+      GlobalBus.emit("event", {
+        payload: {
+          type: "session.next.text.delta",
+          properties: { sessionID: "ses_test", delta: "visible answer" },
+        },
+      })
+      GlobalBus.emit("event", {
+        payload: {
+          type: "session.next.reasoning.delta",
+          properties: { sessionID: "ses_test", delta: "provider reasoning" },
+        },
+      })
+      GlobalBus.emit("event", {
+        payload: {
+          type: "session.next.tool.called",
+          properties: { sessionID: "ses_test", callID: "call_test", tool: "bash", input: { secret: "hidden" } },
+        },
+      })
+    } finally {
+      await output.close()
+    }
+
+    const contents = await Bun.file(file).text()
+    expect(contents).toContain('assistant "visible answer"')
+    expect(contents).toContain('tool.started "bash"')
+    expect(contents).not.toContain("provider reasoning")
+    expect(contents).not.toContain("hidden")
+  })
+
+  test("includes only provider-exposed reasoning text when opted in", async () => {
+    await using tmp = await tmpdir()
+    const file = path.join(tmp.path, "output.txt")
+    const output = await createDaemonOutput(file, true)
+    try {
+      GlobalBus.emit("event", {
+        payload: {
+          type: "session.next.reasoning.delta",
+          properties: {
+            sessionID: "ses_test",
+            delta: "provider reasoning",
+            providerMetadata: { encrypted: "hidden metadata" },
+          },
+        },
+      })
+    } finally {
+      await output.close()
+    }
+
+    const contents = await Bun.file(file).text()
+    expect(contents).toContain('reasoning "provider reasoning"')
+    expect(contents).not.toContain("hidden metadata")
+  })
+})
