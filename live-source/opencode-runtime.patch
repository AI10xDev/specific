+type State = {
+  id: string
+  token: string
+  resolve: () => void
+  stopped: Promise<void>
+}
+
+let state: State | undefined
+
+export function configure(input: { id: string; token: string }) {
+  let resolve = () => {}
+  const stopped = new Promise<void>((done) => {
+    resolve = done
+  })
+  state = { ...input, resolve, stopped }
+  return stopped
+}
+
+export function info(token: string | undefined) {
+  if (!state || token !== state.token) return undefined
+  return { id: state.id, pid: process.pid }
+}
+
+export function stop(token: string | undefined) {
+  if (!state || token !== state.token) return false
+  state.resolve()
+  return true
+}
+
+export function reset() {
+  state = undefined
+}
+
+export * as DaemonControl from "./daemon-control"
